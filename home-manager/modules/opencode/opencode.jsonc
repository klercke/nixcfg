{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "@dietrichgebert/ponytail",
    "opencode-caveman"
  ],

  // Nix owns updates
  "autoupdate": false,

  // No accidental leaks
  "share": "disabled",

  "lsp": true,

  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      // Last match wins
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git push*": "ask",
      "git commit --no-verify*": "deny",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "nixos-rebuild *": "deny",
      "home-manager *": "deny",
      "nh *": "deny"
    }
  }
}
