{
  "$schema": "https://opencode.ai/config.json",

  "plugin": ["@dietrichgebert/ponytail"],

  // Nix owns updates
  "autoupdate": false,

  // No accidental leaks
  "share": "disabled",
  "lsp": true,

  // Everything routes through the ProtoNet gateway (LiteLLM on llm01)
  "model": "protonet/local-coder",

  // Titles and summaries: cheap, and works when thor is off
  "small_model": "protonet/haiku",

  "provider": {
    "protonet": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ProtoNet LLM gateway",
      "options": {
        "baseURL": "https://llm.int.ptxe.dev/v1",

        // Scoped LiteLLM key, kept outside the repo until sops exists
        "apiKey": "{file:~/.config/opencode/litellm.key}"
      },
      "models": {
        "local-coder": {
          "name": "gpt-oss 20B (thor)",
          "limit": { "context": 32768, "output": 8192 }
        },
        "haiku": { "name": "Claude Haiku 5.5" },
        "sonnet": { "name": "Claude Sonnet 5.5" },
        "opus": { "name": "Claude Opus 5.5" }
      }
    }
  },

  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      // Last match wins
      "*": "ask",
      "ls *": "allow",
      "cat *": "allow",
      "rg *": "allow",
      "grep *": "allow",
      "find *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git push*": "ask",
      "git commit --no-verify*": "deny",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "nixos-rebuild *": "deny",
      "home-manager *": "deny",
      "nh *": "deny"
    }
  }
}
