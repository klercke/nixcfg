{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "height": 15,
    "width": 30,
    "color": {
      "1": "#cc241d",
      "2": "#fe8019",
      "3": "#d79921",
      "4": "#98971a",
      "5": "#458588",
      "6": "#b16286"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "════════════════ Begin System Report ═════════════════"
    },
    "break",
    {
      "type": "custom",
      "format": "┌───────────────────── Hardware ─────────────────────┐"
    },
    {
      "type": "host",
      "key": "› HOST",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "› CPU",
      "keyColor": "green"
    },
    {
      "type": "gpu",
      "key": "› GPU",
      "keyColor": "green"
    },
    {
      "type": "memory",
      "key": "› RAM",
      "keyColor": "green"
    },
    {
      "type": "tpm",
      "key": "› TPM",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": "› DISK",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "┌───────────────────── Software ─────────────────────┐"
    },
    {
      "type": "os",
      "key": "› OS",
      "keyColor": "yellow"
    },
    {
      "type": "kernel",
      "key": "› KERN",
      "keyColor": "yellow"
    },
    {
      "type": "bios",
      "key": "› BIOS",
      "keyColor": "yellow"
    },
    {
      "type": "packages",
      "key": "› PKGS",
      "keyColor": "yellow"
    },
    {
      "type": "shell",
      "key": "› SHELL",
      "keyColor": "yellow"
    },
    {
      "type": "locale",
      "key": "› LOCALE",
      "keyColor": "yellow"
    },
    "break",
    {
      "type": "de",
      "key": "› DE",
      "keyColor": "blue"
    },
    {
      "type": "lm",
      "key": "› LM",
      "keyColor": "blue"
    },
    {
      "type": "wm",
      "key": "› WM",
      "keyColor": "blue"
    },
    {
      "type": "wmtheme",
      "key": "› THEME",
      "keyColor": "blue"
    },
    {
      "type": "terminal",
      "key": "› TERM",
      "keyColor": "blue"
    },
    {
      "type": "editor",
      "key": "› EDITOR",
      "keyColor": "blue"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "custom",
      "format": "┌───────────────────── Network ──────────────────────┐"
    },
    {
      "type": "dns",
      "key": "› DNS",
      "keyColor": "cyan",
      "showType": "both"
    },
    {
      "type": "localip",
      "key": "› IPV4",
      "keyColor": "cyan",
      "showIpv4": true,
      "showIpv6": "false",
      "showPrefixLen": true
    },
    {
      "type": "localip",
      "showIpv6": false,
      "key": "› IPV6",
      "keyColor": "cyan",
      "showPrefixLen": true,
      "showIpv4": false
    },
    {
      "type": "title",
      "fqdn": true,
      "key": "› TITLE",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────┘"
    },
    {
      "type": "break"
    },
    {
      "type": "custom",
      "format": "┌────────────────────── Chrono ──────────────────────┐"
    },
    {
      "type": "uptime",
      "key": "› UP",
      "keyColor": "magenta"
    },
    {
      "type": "command",
      "key": "› AGE",
      "keyColor": "magenta",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "datetime",
      "key": "› NOW",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────────┘"
    },
    {
      "type": "break"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ],
  "display": {
    "separator": ": ",
    "key": {
      "width": 12,
      "paddingLeft": 1,
      "type": "string"
    }
  },
  "general": {}
}
